{
  "name": "dsh-mcp-servers-panel",
  "version": "0.2.0",
  "description": "DSH MCP 服务器管理插件：在设置中提供 MCP Servers 管理面板，负责把服务器配置写入当前 Profile 的 cordis.patch.yml 并启停官方 @deepseek-ai/dsh-mcp-client 条目；连接、重连、工具注册与 teardown 由官方 client 负责。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "mcp",
    "model-context-protocol",
    "cordis"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/patch-store.test.js test/manager.test.js test/native-mcp.test.js test/security.test.js test/apply-endpoints.test.js test/client.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "native-mcp.js",
    "patch-store.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whiteS18/dsh-mcp-servers-panel.git"
  },
  "bugs": "https://github.com/whiteS18/dsh-mcp-servers-panel/issues",
  "homepage": "https://github.com/whiteS18/dsh-mcp-servers-panel#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
